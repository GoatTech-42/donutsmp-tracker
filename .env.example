# Create a key in-game with /api. Leave blank to run with safe demo data.
DONUTSMP_API_KEY=
DONUTSMP_API_URL=https://api.donutsmp.net
PORT=3001
SCAN_INTERVAL_MS=300000
AUCTION_PAGES=20
TRANSACTION_PAGES=5
API_TIMEOUT_MS=12000
AUCTION_TAX_RATE=0.05

# Optional third-party /orders-compatible JSON endpoint.
# The official API does not expose orders as of August 2026.
DONUTSMP_ORDERS_API_URL=
DONUTSMP_ORDERS_API_KEY=

# Optional AI market brief
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_MODEL=openai/gpt-oss-120b

# DonutSMP API key auto-revival via mc-headless (optional). When the key
# dies (401), pulse asks mc-headless to log in and regenerate it in-game.
# MC_REVIVE_TOKEN must match the mc-headless dashboard-token file.
MC_REVIVE_URL=
MC_REVIVE_TOKEN=
MC_REVIVE_CALLBACK_URL=
